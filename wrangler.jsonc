/**
 * 有关如何配置 Wrangler 的更多详细信息，请参考：
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "test",
	"main": "src/index.js",
	"compatibility_date": "2025-10-11",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./assets/",
		"binding": "ASSETS"
	},
	"triggers": {
		"crons": ["* * * * *"]
	}
}
